# Godot 4+ specific ignores
.godot/
# Stale accidental nested copy of the project's own root config files
# (merged in via f1b6c7e) — removed from git; keep it ignored so a
# recreated copy never gets tracked again. Its project.godot was a
# d3d12 leftover that made Godot warn "Detected another project.godot"
# on every launch.
bunker-game/
/android/
.env
*.tmp
task.md
# Godot 4.4+ auto-generated script UID sidecars — regenerated on demand,
# never need to be in VCS (this repo uses inline uid= headers instead).
*.uid

# Dev/agent scratch — not project content
# 280 MB Quaternius source-pack zip (import sidecars live next to it, the
# zip itself is a large binary the repo never needs).
assets/models/WIP/FINAL/Modular Character Outfits - Fantasy\[Standard\].zip
_dup_diag.log
godot_sandbox/
.claude/
